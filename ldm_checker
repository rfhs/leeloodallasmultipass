#!/bin/sh
set -eu
status_dir='/root/shared_persistent_storage'
clientstatus="${status_dir}/Client_status"
missing_tools=""
# ldm_checker
for tool in awk date mkdir pgrep stat; do
  command -v "${tool}" > /dev/null 2>&1 || missing_tools="${missing_tools} ${tool} (ldm_checker)"
done
if [ "${1:-}" = "--test" ]; then
  # ldm, including the commands it runs only in some branches
  for tool in arping cat dhcpcd grep mkdir rm screen sed sleep; do
    command -v "${tool}" > /dev/null 2>&1 || missing_tools="${missing_tools} ${tool} (ldm)"
  done
  # unified_client, including the commands it runs only in some branches
  for tool in arping awk date dhcpcd grep head ip iw pkill sed seq sleep timeout touch wpa_supplicant; do
    command -v "${tool}" > /dev/null 2>&1 || missing_tools="${missing_tools} ${tool} (unified_client)"
  done
  # helpers/RFHS_WPA_HIDDEN_2G
  command -v sleep > /dev/null 2>&1 || missing_tools="${missing_tools} sleep (helpers/RFHS_WPA_HIDDEN_2G)"
fi
if [ -n "${missing_tools}" ]; then
  message="${0##*/}: required commands not found:${missing_tools}"
  printf '%s\n' "${message}"
  if [ -d "${status_dir}" ] || mkdir -p "${status_dir}" 2> /dev/null; then
    printf '%s\n' "${message}" > "${clientstatus}"
  fi
  exit 1
fi
[ ! -d "${status_dir}" ] && mkdir -p "${status_dir}"
header="# This file is auto generated once per minute (ideally) and NEVER read by anything
# Last generation start time $(date) (compare to \"date\" command)"
printf '%s\n' "${header}"
printf '%s\n' "${header}" > "${clientstatus}"

#XXX WARNING XXX
# This only supports ldm conf files with a max of 4 wpa_supplicant conf files per interface

# One pgrep, one stat, one date and one awk for all the clients. pgrep has
# to finish before awk starts, or it would list awk, whose program mentions
# unified_client. A missing status file just isn't listed.
procs="$(pgrep -af unified_client)" || true
mtimes="$(stat -c '%Y %n' /run/rfctf_status/*_attempt /run/rfctf_status/*_active 2> /dev/null)" || true

# For each conf file on each ldm.conf line: a unified_client running with the
# line's timeout and that conf file, matched as a regex as pgrep -f does; then,
# for the conf file's SSID (its first ssid= line, read as unified_client reads
# it), a connection attempt and, unless --test, a connection success within
# the timeout times the line's number of conf files, plus 60 s.
LDM_PROCS="${procs}" LDM_MTIMES="${mtimes}" awk -v test="${1:-}" -v status="${clientstatus}" -v now="$(date +%s)" '
  function out(msg) {
    printf "%s", msg
    printf "%s", msg >> status
  }
  BEGIN {
    nprocs = split(ENVIRON["LDM_PROCS"], procs, "\n")
    n = split(ENVIRON["LDM_MTIMES"], lines, "\n")
    for (i = 1; i <= n; i++) {
      split(lines[i], f, " ")
      mtime[substr(lines[i], length(f[1]) + 2)] = f[1]
    }
    exit_code = 0
    while ((getline line < "ldm.conf") > 0) {
      if (line ~ /^#/) continue
      nf = split(line, f)
      confs = 0
      for (k = 4; k <= 7 && k <= nf; k++) confs++
      for (k = 4; k <= 7 && k <= nf; k++) check(f[k], f[3], confs)
    }
    if (exit_code == 0) out("Everything is operating as expected.\n")
    else out("Something is not operating as expected.\n")
    exit exit_code
  }
  function check(conffile, requested_timeout, confs,    timeout, pattern, running, i, ssid, cfg, l, r, file, diff) {
    timeout = requested_timeout * confs + 60
    pattern = "unified_client .* " requested_timeout ".*" conffile
    running = 0
    for (i = 1; i <= nprocs; i++) if (procs[i] ~ pattern) running = 1
    if (!running) {
      out(sprintf("No unified_client running for configured %s\n", conffile))
      exit_code = 1
    }
    ssid = ""
    cfg = "config/" conffile
    while ((r = (getline l < cfg)) > 0) {
      sub(/^[ \t\r\v\f]*/, "", l)
      gsub(/"/, "", l)
      if (sub(/^ssid=/, "", l)) {
        ssid = l
        break
      }
    }
    if (r < 0) printf "ldm_checker: cannot read %s\n", cfg > "/dev/stderr"
    close(cfg)
    file = "/run/rfctf_status/" ssid "_attempt"
    if (!(file in mtime)) {
      out(sprintf("No connection attempt on configured ssid %s\n", ssid))
      exit_code = 1
      return
    }
    diff = now - mtime[file]
    if (diff > timeout) {
      out(sprintf("No connection attempt on configured ssid %s in %ss\n", ssid, diff))
      exit_code = 1
    }
    if (test == "--test") return
    file = "/run/rfctf_status/" ssid "_active"
    if (file in mtime) {
      diff = now - mtime[file]
      if (diff <= timeout) return
      out(sprintf("No connection success on configured ssid %s in %ss\n", ssid, diff))
    } else {
      out(sprintf("No connection success on configured ssid %s\n", ssid))
    }
    # These are client only, so it is okay if they failed to connect
    if (ssid != "RFHS_RFCTF_00" && ssid != "RFHS_RFCTF_03" && ssid != "RFHS_RFCTF_06") exit_code = 1
  }'
