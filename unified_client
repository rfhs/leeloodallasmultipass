#!/bin/sh

if [ -x "$(command -v id 2> /dev/null)" ]; then
  USERID="$(id -u 2> /dev/null)"
fi

if [ -z "${USERID}" ] && [ -n "${UID}" ]; then
  USERID=${UID}
fi

if [ -n "${USERID}" ] &&  [ "${USERID}" != "0" ]; then
  printf "Run it as root\n" ; exit 1;
elif [ -z "${USERID}" ] && [ -z "${UID}" ]; then
  printf "Unable to detect if running as root\n"
fi

if [ -z "${3}" ]; then
  printf "Usage: %s <interface> <connection time in seconds> <wpa_supplicant.conf> [wpa_supplicant.conf]\n" "${0}"
  exit 1
fi

interface="${1}"
shift
connection_timeout="${1}"
shift
conf_files="${*}"

#wait for interface
printf "Waiting for %s...\n" "${interface}"
while true; do
  if [ -e "/sys/class/net/${interface}" ]; then
    break
  fi
  sleep 1
done
printf "We have %s, continuing...\n" "${interface}"

# The polls below run every second, so these two only use the shell's
# builtins: they start no processes.

# associated: succeeds while the interface is associated with an AP, which is
# when iw link says "Connected". The kernel turns the interface's carrier on
# when it associates. Reading the carrier fails while the interface is down,
# and that counts as not associated.
associated() {
  carrier=""
  read -r carrier 2> /dev/null < "/sys/class/net/${interface}/carrier"
  [ "${carrier}" = 1 ]
}

# find_gateway: sets gateway to the interface's default gateway, e.g.
# 172.17.42.1, or to nothing when it has none. /proc/net/route has a line per
# route, starting with its interface, destination and gateway:
#   Iface   Destination  Gateway   Flags ...
#   wlan10  00000000     012A11AC  0003  ...
# The default route's destination is 00000000. The gateway is in hex with its
# bytes in reverse order: 012A11AC is 01 2A 11 AC, so 172.17.42.1.
find_gateway() {
  gateway=""
  while read -r route_interface destination hex_gateway _; do
    if [ "${route_interface}" = "${interface}" ] && [ "${destination}" = 00000000 ] \
      && [ "${hex_gateway}" != 00000000 ]; then
      # cut 012A11AC into its bytes: ${x#??} is x without its first two
      # characters, ${x%??} x without its last two
      byte1="${hex_gateway%??????}" # 01
      byte2="${hex_gateway#??}"     # 2A11AC
      byte2="${byte2%????}"         # 2A
      byte3="${hex_gateway#????}"   # 11AC
      byte3="${byte3%??}"           # 11
      byte4="${hex_gateway#??????}" # AC
      gateway="$((0x${byte4})).$((0x${byte3})).$((0x${byte2})).$((0x${byte1}))"
      return
    fi
  done < /proc/net/route
}

# politekill pattern...: TERM, then a second later KILL, for the processes
# whose command line matches any of the patterns; one pkill each, as every
# pkill -f reads every process's command line. No pattern may be empty: that
# would match every process.
politekill() {
  pattern=""
  for i in "${@}"; do
    pattern="${pattern}${pattern:+|}${i}"
  done
  pkill -TERM -f "${pattern}"
  sleep 1
  pkill -9 -f "${pattern}"
}

control_c() {
  politekill "${arping_cmdline}" "${dhcp_title}" "${wpa_supplicant_cmdline}"
  ip addr flush dev "${interface}"
  exit
}

trap control_c INT
trap control_c TERM
trap control_c EXIT

#todo: detect arping more correctly, including debian/raspbian arping
if [ -x /usr/bin/arping ]; then
	which_arping="/usr/bin/arping -c 5 -w 5 -I"
elif [ -x /usr/sbin/arping ]; then
	which_arping="/usr/sbin/arping -c 5 -W 1 -i -v"
elif [ -x /bin/arping ]; then
  # I thin raspios moved this to /usr/bin/arping
	which_arping="/bin/arping -c 5 -w 5 -I"
fi

while true;
do
  #this loop includes between 10 and 50 seconds of sleep for each config file in "conf_files"
  #so each AP will have a client connected for 30ish seconds at least once every number of conf_files minutes (absent deauth floods)
  for conffile in ${conf_files}; do
    if [ ! -e "config/${conffile}" ]; then
      printf "config/%s specified at the command line is not present, failing.\n" "${conffile}"
      exit 1
    fi
    if [ ! -r "config/${conffile}" ]; then
      printf "config/%s specified at the command line is not readable, failing.\n" "${conffile}"
      exit 1
    fi
    ssid=$(sed -n -e 's/^[[:space:]]*//g' -e 's/"//g' -e '/^ssid=/s/ssid=//p' "config/${conffile}" | head -n1)
    #set each command as a variable so it is always identical in the code
    dhcp_cmdline="dhcpcd --waitip=4 --hostname=${ssid} --noipv4ll --ipv4only ${interface} --request=0.0.0.0"
    # dhcpcd replaces its command line with "dhcpcd: <interface> [ip4]", and
    # nothing lets us choose it, so it is killed by that; ldm_checker
    # --excessive checks dhcpcd still titles itself so
    dhcp_title="^dhcpcd: ${interface} "
    wpa_supplicant_cmdline="wpa_supplicant -Dnl80211 -i ${interface} -c config/${conffile}"
    arping_cmdline="${which_arping} ${interface}"

    #kill everything and ensure it's dead
    politekill "${wpa_supplicant_cmdline}" "${dhcp_title}" "${arping_cmdline}"

    #start new wpa_supplicant and wait up to 12 seconds for a connection
    printf "Attempting to connect %s to SSID: %s for %ss using config %s...\n" "${interface}" "${ssid}" "${connection_timeout}" "${conffile}"
    ${wpa_supplicant_cmdline} &
    tries=0
    while [ "${tries}" -lt 12 ]; do
      if associated; then
        break
      fi
      sleep 1
      tries=$((tries + 1))
    done

    #start new dhcp client and wait up to 28 seconds for success
    ${dhcp_cmdline} &
    tries=0
    while [ "${tries}" -lt 28 ]; do
      find_gateway
      if [ -n "${gateway}" ]; then
        break
      fi
      sleep 1
      tries=$((tries + 1))
    done

    #register connection attempt
    touch "/run/rfctf_status/${ssid}_attempt"

    find_gateway
    if [ -n "${gateway}" ]; then
      printf "We have an ip address\n"
      start_time=$(date '+%s')
      while [ "${start_time}" -gt $(( $(date '+%s') - connection_timeout )) ]; do
        #we should be checking arping success but the exit codes are weird
        find_gateway
        if [ -n "${gateway}" ]; then
          ${arping_cmdline} "${gateway}"
        else
          # with no gateway (e.g. deauthed) arping fails at once, so without
          # this the loop would spin until the gateway is back
          sleep 1
        fi
        #register connection success
        #since we are not 100% sure we are connected, let's include the ip address for now
        ip addr show dev "${interface}" 2>&1 | awk '/inet / {print $2}' > "/run/rfctf_status/${ssid}_active"
        if [ -x "helpers/${conffile%.*}" ]; then
          timeout 10 "helpers/${conffile%.*}"
        fi
      done
    else
      printf "We never got an ip address, recycling.\n"
    fi

    #disconnect and cleanup
    politekill "${wpa_supplicant_cmdline}" "${dhcp_title}" "${arping_cmdline}"
    sleep 1
    ip addr flush dev "${interface}"
  done
done
